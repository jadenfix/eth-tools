# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Node / Next.js
node_modules/
.next/
.turbo/
dist/
build/
*.tsbuildinfo
.pnpm-store/

# Vercel
.vercel/

# Env files (commit only .env.example)
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# Key material — defence in depth against accidental commits
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
*.gpg
secrets.*
.envrc

# Agent caches — local-only state lives in subdirs we name explicitly so the
# committed slash-command + rules directories ride along.
.claude/cache/
.claude/logs/
.claude/sessions/
.claude/local/
.claude/state/
.cursor/cache/

# Test artifacts
test-results/
playwright-report/
coverage/

# sqlx offline cache (committed for CI; uncomment to ignore)
# .sqlx/

# Local databases
*.db
*.sqlite

# Generated types — committed; CI verifies no drift
# app/lib/api-types.ts
# public/openapi.json

# Local logs
*.log
npm-debug.log*
pnpm-debug.log*
