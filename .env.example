# Local development env. Copy to .env.local and fill in.
# Production / preview values are injected by Vercel; never commit real secrets.

# ---- Database (Neon in prod; local Postgres via docker compose) ----
DATABASE_URL=postgres://dev:dev@localhost:5432/eth_tools?sslmode=disable
DATABASE_URL_UNPOOLED=postgres://dev:dev@localhost:5432/eth_tools?sslmode=disable

# ---- Cache / rate-limit (Upstash in prod; Dragonfly locally) ----
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=dev

# ---- RPC (Alchemy primary, QuickNode fallback) ----
RPC_URL_PRIMARY=http://localhost:8545
RPC_URL_FALLBACK=https://mainnet.base.org

# ---- Cron protection ----
CRON_SECRET=dev-cron-secret-change-me

# ---- Auth.js v5 (GitHub OAuth) ----
AUTH_SECRET=dev-auth-secret-replace-me-with-openssl-rand-base64-32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Wallet (env-var pattern with hard rails — plan §10) ----
# NEVER commit a real private key. Local dev uses an Anvil-generated key only.
EVM_PRIVATE_KEY=
EVM_PUBLIC_KEY=

# ---- Vercel environment (auto-set in deploys) ----
VERCEL_ENV=development
