# Local development env. Copy to .env.local and fill in.
# Production / preview values are injected by Vercel; never commit real secrets.
#
# When adding to Vercel, mark every line tagged [SENSITIVE] with the
# --sensitive flag (default-on in current CLI; verify with `vercel env ls`).
# Example: vercel env add EVM_PRIVATE_KEY production --sensitive

# ---- Database (Neon in prod; local Postgres via docker compose) ----
# [SENSITIVE in prod] — Neon Marketplace integration injects automatically.
DATABASE_URL=postgres://dev:dev@localhost:5432/eth_tools?sslmode=disable
DATABASE_URL_UNPOOLED=postgres://dev:dev@localhost:5432/eth_tools?sslmode=disable

# ---- Cache / rate-limit (Upstash in prod; Dragonfly locally) ----
# [SENSITIVE in prod] — Upstash Marketplace integration injects automatically.
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=dev

# ---- RPC (Alchemy primary, QuickNode fallback) ----
# [SENSITIVE in prod] — API keys live in the URL path.
RPC_URL_PRIMARY=http://localhost:8545
RPC_URL_FALLBACK=https://mainnet.base.org

# ---- Cron protection ----
# [SENSITIVE in prod] — cron handlers FAIL-CLOSED in production if unset.
# Generate with: openssl rand -base64 32
CRON_SECRET=dev-cron-secret-change-me

# ---- MCP server (Phase-5) ----
# [SENSITIVE in prod] — single static bearer token gating /api/mcp/*.
# Production fail-closed: when VERCEL_ENV=production and this is empty
# or unset, every request returns 500 MCP_BEARER_TOKEN_MISCONFIGURED.
# In dev/preview the server logs a loud warning and serves
# UNAUTHENTICATED requests (intended for local dev only). Replace with
# OAuth-Protected Resource flow when crates/api::auth lands in Phase-5.5.
MCP_BEARER_TOKEN=

# Comma-separated hostnames (no globs) that rmcp accepts in the inbound
# `Host` header — DNS-rebinding defense. The server already permits
# `localhost`, `127.0.0.1`, `::1`, `eth-tools.dev`, and
# `preview.eth-tools.dev` by default; add Vercel preview deploy URLs
# (e.g. `eth-tools-git-feature-x.vercel.app`) here at deploy time.
MCP_ALLOWED_HOSTS=

# ---- Auth.js v5 (GitHub OAuth) ----
# [SENSITIVE in prod] — AUTH_SECRET is the JWT-signing key.
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-auth-secret-replace-me-with-openssl-rand-base64-32
AUTH_GITHUB_ID=
# [SENSITIVE in prod]
AUTH_GITHUB_SECRET=

# ---- Wallet (env-var pattern with hard rails — plan §10) ----
# [SENSITIVE in prod] — NEVER commit a real private key.
# Local dev uses an Anvil-generated key only. Prod: rotate via Safe sweep.
EVM_PRIVATE_KEY=
# [PUBLIC] — derived from EVM_PRIVATE_KEY; logged at boot for sanity.
EVM_PUBLIC_KEY=

# ---- x402 paid-write protocol (Phase 6) ----
# [PUBLIC] CDP facilitator endpoint — settles EIP-3009 transferWithAuthorization.
# Production: https://x402.org/facilitator (CDP). Local dev: leave unset to
# bypass settlement (writes will respond 402 but not actually charge).
X402_FACILITATOR_URL=
# [PUBLIC] EOA address that receives x402 payments. Read from /api/v1/wallet
# at boot for client integration. Distinct from EVM_PRIVATE_KEY (relay wallet).
X402_PAY_TO_ADDRESS=

# ---- Dashboard → Rust API (local dev only) ----
# In Vercel prod the Next.js dashboard hits same-host /api/v1/* directly.
# For local dev, point at the crates/dev-server Axum binary on :3000.
INTERNAL_API_URL=http://127.0.0.1:3000

# ---- Vercel environment (auto-injected in deploys) ----
VERCEL_ENV=development
